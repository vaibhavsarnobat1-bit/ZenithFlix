# Frontend build-time config. Copy to `.env` (or set in the hosting dashboard).
# Everything here is OPTIONAL — with nothing set the app talks to its own
# origin, which is what the Vercel build does.

# Origin of an always-on backend (Render/Railway/Fly) running
# backend/server.js. Only a process that never sleeps can hold a WebSocket, so
# this is what lights up the live Watch Party room. Leave it empty for a
# serverless-only deployment: the room entry points stay hidden and sharing
# falls back to the "Watch Together" link, which needs no backend at all.
# Origin only — no trailing slash, no path.
VITE_PARTY_BASE=

# Public HTTPS origin of the hosted site, used to build invite links. Leave
# empty when invites can point at the page origin (localhost).
VITE_PUBLIC_WEB_ORIGIN=
